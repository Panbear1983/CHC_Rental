# CHC_Rental — environment variable placeholders only.
# Copy to .env and fill in real values locally. Never commit .env.

# Telegram bot token used by the OUTBOUND-ONLY notifier.
# No inbound poller/handler exists in this codebase.
TELEGRAM_BOT_TOKEN=changeme

# Licensed RentCast rental-listing source. A placeholder is treated as absent.
RENTCAST_API_KEY=changeme

# Owner-approved, terms-flagged managed Zillow rental source. A token alone is
# inert: config/settings.yaml must also contain `zillow_enabled: true`.
APIFY_TOKEN=changeme
