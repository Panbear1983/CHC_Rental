# CHC_Rental — environment variable placeholders only.
# Copy to .env and fill in real values locally. Never commit .env.
# Phase 1 does not read or use any of these; they are placeholders for later phases.

# Telegram bot token used by a future OUTBOUND-ONLY notifier (Phase 5+).
# No inbound poller/handler exists in this codebase.
TELEGRAM_BOT_TOKEN=changeme

# Path to the local SQLite database file.
CHC_RENTAL_DB_PATH=data/chc_rental.sqlite3

# Licensed listing-source API key (Phase 3+, not yet implemented).
RENTCAST_API_KEY=changeme
